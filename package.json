{
  "name": "meetmind",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "lint": "pnpm --filter @meetmind/web lint",
    "typecheck": "pnpm --filter @meetmind/web typecheck",
    "test": "pnpm --filter @meetmind/web test"
  }
}
