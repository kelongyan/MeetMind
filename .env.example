APP_NAME=MeetMind API
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=["http://localhost:3927","http://127.0.0.1:3927"]

DATABASE_URL=postgresql+psycopg://meetmind:meetmind@localhost:5432/meetmind
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=meetmind-local
S3_ACCESS_KEY_ID=meetmind
S3_SECRET_ACCESS_KEY=meetmind-local-password

UPLOAD_STORAGE_DIR=storage/uploads
TRANSCRIPTION_WORK_DIR=storage/transcription
TRANSCRIPTION_CHUNK_MS=600000
FFMPEG_BINARY=
ASR_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
LLM_PROVIDER=disabled
OPENAI_LLM_MODEL=gpt-4.1-mini
LLM_PROMPT_VERSION=phase4-structure-v1
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=local-hash-1536
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QA_ANSWER_PROVIDER=extractive
QA_MIN_RETRIEVAL_SCORE=0.1
LLM_COST_PER_1K_CHARS_USD=0
EMBEDDING_COST_PER_1K_CHARS_USD=0
QA_COST_PER_1K_CHARS_USD=0
TASK_SYNC_PROVIDER=disabled
TASK_SYNC_WEBHOOK_URL=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
